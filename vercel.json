{
  "buildCommand": "node node_modules/vite/bin/vite.js build && node scripts/prerender.mjs",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [{ "source": "/services", "destination": "/solutions", "permanent": true }],
  "rewrites": [{ "source": "/(.*)", "destination": "/app-shell.html" }]
}
